# Maintainer: Estanislao Pérez Nartallo <tanisperez@gmail.com>
#
# Template of the AUR package `tterm-bin`. `pkgver` and the checksum are filled in for each
# release (`updpkgsums`, or by CI once the AUR account exists, see packaging/aur/README.md).
pkgname=tterm-bin
pkgver=0.1.0
pkgrel=1
pkgdesc='A fast, native terminal emulator'
arch=('x86_64')
url='https://terminal.tanis.codes'
license=('Apache-2.0')
depends=('libxkbcommon' 'libxkbcommon-x11' 'libxcb' 'wayland' 'libglvnd')
optdepends=('vulkan-icd-loader: Vulkan renderer')
provides=('tterm')
conflicts=('tterm')
source=("tterm-$pkgver-linux-x86_64.tar.gz::https://github.com/tanisperez/terminal/releases/download/v$pkgver/tterm-$pkgver-linux-x86_64.tar.gz")
sha256sums=('SKIP')

package() {
    cd "tterm-$pkgver-linux-x86_64"
    install -Dm755 bin/tterm "$pkgdir/usr/bin/tterm"
    cp -r share "$pkgdir/usr/share"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
}
